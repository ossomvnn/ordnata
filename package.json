{
  "name": "house-manager-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder" 
    /* <-- Der einfache Build-Befehl */
  },
  // ... andere Keys wie "keywords", "author" ...
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  },
  
  /* NEUE BUILD-SEKTION FÜR electron-builder */
  "build": {
    "appId": "com.ossomvn.housemanager",
    "productName": "Ordnata App",
    "copyright": "Copyright © 2025 ${author}",
    "files": [
      "**/*",
      "!node_modules/*" 
    ],
    "directories": {
      "output": "release-builds"
    },
    "win": {
      "target": "nsis",
      "icon": "css/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "css/logo.png" 
      /* Electron-builder kann .png für Mac verwenden */
    }
  }
}
