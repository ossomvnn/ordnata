{
  "name": "ordnata-app",
  "version": "1.0.0",
  "description": "Desktop application for managing resident access and cleaning schedules.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder" 
    /* Dieser Befehl baut die Windows und Mac Versionen */
  },
  "keywords": [
    "electron",
    "ordnata",
    "management",
    "web-app"
  ],
  "author": "ossomvn",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.1",
    "electron-builder": "^24.9.1"
  },
  
  /* NEUE BUILD-SEKTION FÜR electron-builder */
  "build": {
    "appId": "com.ossomvn.ordnata",
    "productName": "Ordnata",
    "copyright": "Copyright © 2025 ossomvn",
    "files": [
      "**/*",
      "!node_modules/*" 
    ],
    "directories": {
      "output": "release-builds"
    },
    "win": {
      "target": "nsis",
      "icon": "css/logo.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "css/logo.png" 
    }
  }
}
